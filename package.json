{
  "name": "forge-workflow",
  "version": "0.1.0-beta.8",
  "packageManager": "bun@1.4.2",
  "description": "Local runtime control plane for AI-assisted engineering workflows, gates, evidence, and all AI agents",
  "bin": {
    "forge": "bin/forge.js",
    "forge-workflow": "bin/forge.js",
    "forge-preflight": "bin/forge-preflight.js"
  },
  "workspaces": [
    "packages/skills"
  ],
  "scripts": {
    "test": "bun test --timeout 15000",
    "test:setup": "bash test-env/automation/setup-fixtures.sh",
    "test:all": "bun run test:setup && bun test --timeout 15000",
    "test:coverage": "c8 --check-coverage bun test --timeout 15000",
    "test:ci:shard": "node scripts/test-ci-shard.js",
    "typecheck": "echo 'No TypeScript in project - skipping type check'",
    "gen:manifest": "node scripts/gen-command-manifest.js",
    "gen:manifest:check": "node scripts/gen-command-manifest.js --check",
    "prebuild": "node scripts/gen-command-manifest.js",
    "lint": "eslint . --max-warnings 0",
    "check": "node scripts/validate.js",
    "setup": "node ./bin/forge.js setup",
    "help": "node ./bin/forge.js --help",
    "gen:assets": "bun scripts/gen-embedded-assets.mjs",
    "build:binary": "bun scripts/gen-embedded-assets.mjs && bun build --compile --define FORGE_COMPILED=true ./bin/forge.js --outfile forge-bin",
    "parity:binary": "bun scripts/parity-check.mjs",
    "validate:yaml": "bash -c 'find . \\( -name \"*.yml\" -o -name \"*.yaml\" \\) | grep -v node_modules | while IFS= read -r file; do echo \"Checking $file...\" && bun x yaml valid < \"$file\" > /dev/null || exit 1; done'",
    "test:mutation": "npx stryker run",
    "test:benchmark": "node scripts/benchmark.js --output test-results/benchmark-results.json --profile-dir test-results/benchmark-profiles",
    "test:benchmark:full": "node scripts/benchmark.js --output test-results/benchmark-full-results.json --profile-dir test-results/benchmark-full-profiles --group full-suite --group validate",
    "test:full:parallel": "node scripts/test-full-suite.js",
    "test:dashboard": "node scripts/test-dashboard.js",
    "test:profile": "node scripts/test-profile.js --input-dir test-results --output test-results/test-profile.profile.json --label local",
    "test:randomized": "bun test --timeout 15000 --randomize",
    "test:rerun": "bun test --timeout 15000 --rerun-each 2",
    "agentic:sync": "node scripts/sync-agentic-workflow.js"
  },
  "peerDependencies": {
    "lefthook": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "lefthook": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.0.2",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.3.0"
  },
  "keywords": [
    "ai",
    "workflow",
    "tdd",
    "agents-md",
    "claude-code",
    "cursor",
    "codex",
    "development",
    "testing"
  ],
  "author": "Harsha Nandak",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshanandak/forge.git"
  },
  "homepage": "https://github.com/harshanandak/forge#readme",
  "bugs": {
    "url": "https://github.com/harshanandak/forge/issues"
  },
  "files": [
    "bin/",
    "lib/",
    "!lib/embedded-assets.generated.mjs",
    "!lib/embedded-assets.generated-assets/",
    "!lib/agents/README.md",
    "!lib/pr-monitor/auto-actions.js",
    "!lib/pr-monitor/render-summary.js",
    "!lib/validation/",
    "!lib/workflow-templates/",
    "!lib/bun-release.js",
    "!lib/beta5-compatibility-evidence.js",
    "!lib/fixtures/",
    "!lib/capabilities/",
    "!lib/forge-context.js",
    "!lib/freshness-token.js",
    "!lib/frontmatter.js",
    "!lib/setup.js",
    "!lib/task-ownership.js",
    "!lib/validation-utils.js",
    "!lib/issue-sync/legacy-link-bridge.js",
    "rules/",
    "skills/",
    ".claude/scripts/",
    ".forge/hooks/",
    ".forge/protected-paths.yaml",
    "scripts/check-forge-token.js",
    "scripts/process-tree.js",
    "scripts/test.js",
    "scripts/legacy-claim-repair.js",
    "scripts/protected-state-check.js",
    "scripts/spikes/harness-capability-matrix.js",
    "scripts/spikes/protected-path-manifest.js",
    "scripts/spikes/skill-auto-invoke-parity.js",
    "scripts/preflight-sonar.eslint.config.mjs",
    "scripts/bootstrap-windows-tools.sh",
    "scripts/github-context-bridge.sh",
    "scripts/conflict-detect.sh",
    "scripts/file-index.sh",
    "scripts/pr-coordinator.sh",
    "scripts/sync-utils.sh",
    "scripts/validate.sh",
    "scripts/dep-guard.sh",
    "scripts/dep-guard-analyze.js",
    "scripts/dep-guard-keyword-ripple.js",
    "scripts/dep-guard-render-review.js",
    "scripts/smart-status.sh",
    "scripts/smart-status-score.js",
    "scripts/smart-status-sessions.js",
    "scripts/forge-team/index.sh",
    "scripts/forge-team/lib/",
    "scripts/lib/behavioral-eval-runner.js",
    "scripts/lib/behavioral-eval-runtime.js",
    "scripts/lib/eval-evidence.js",
    "scripts/lib/eval-runner.js",
    "scripts/lib/immutable-eval-corpus.js",
    "scripts/lib/promotion-evidence-loader.js",
    "scripts/lib/promotion-scorecard.js",
    "scripts/lib/transcript-parser.js",
    "scripts/lib/jsonl-lock.sh",
    "scripts/lib/sanitize.sh",
    "docs/guides/SETUP.md",
    "docs/reference/EXAMPLES.md",
    "docs/reference/ROADMAP.md",
    "docs/reference/TOOLCHAIN.md",
    "docs/reference/VALIDATION.md",
    "AGENTS.md",
    "CODING_STANDARDS.md"
  ],
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "cross-spawn": "^7.0.6",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "eslint": "^10.0.2",
    "fast-uri": "^3.1.4",
    "flatted": "3.4.2",
    "minimatch": "10.2.4",
    "brace-expansion": "5.0.9",
    "linkify-it": "^5.0.2",
    "lodash": "4.18.1",
    "qs": "6.16.0"
  },
  "c8": {
    "lines": 80,
    "branches": 80,
    "functions": 80,
    "statements": 80,
    "exclude": [
      "test/**",
      "test-env/**",
      "**/*.test.js",
      "**/*.spec.js",
      "coverage/**",
      ".forge/hooks/**",
      "bin/forge.js"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ]
  }
}
